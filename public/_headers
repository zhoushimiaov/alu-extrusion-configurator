# 单文件 index.html：不做任何边缘/浏览器缓存，保证发版即生效（防反代层钉住旧版）
/index.html
  Cache-Control: no-cache
/
  Cache-Control: no-cache

# 安全响应头（全站）：防点击劫持 / MIME 嗅探 / 过度 Referer / 非必要能力
/*
  X-Frame-Options: DENY
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=()
  Content-Security-Policy: default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self' data:; connect-src 'self'; frame-ancestors 'none'; base-uri 'none'; form-action 'none'

# 图片资产：favicon/webp 内容稳定可 immutable；og-cover.jpg 会重制，保持 1 天
/*.png
  Cache-Control: public, max-age=31536000, immutable
/*.webp
  Cache-Control: public, max-age=31536000, immutable
/*.jpg
  Cache-Control: public, max-age=86400
